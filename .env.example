# Supabase project (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used for privileged admin operations (inviting staff users) and for the
# NOWPayments create-payment/IPN routes, which need to write to `orders`
# without a staff session.
SUPABASE_SERVICE_ROLE_KEY=

# NOWPayments (https://nowpayments.io) — SERVER ONLY, never prefix with
# NEXT_PUBLIC_. Get these from your NOWPayments dashboard under
# Settings -> API keys / IPN settings. Used only in src/lib/nowpayments.ts
# and the two src/app/api/nowpayments/* routes.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Canonical site URL — used for metadata, sitemap.xml, OpenGraph tags, and
# the NOWPayments ipn_callback_url. Always set this in production; never let
# it fall back to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Build-time fallback Telegram handle for "Order via Telegram" buttons, used
# only if site_settings.telegram_username isn't reachable (e.g. before
# Supabase is connected). Once connected, manage this from Admin > Settings.
NEXT_PUBLIC_TELEGRAM_USERNAME=GoCloudShopSupport
